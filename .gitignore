# Secrets — never commit
.env
.env.*
!.env.example

node_modules/
.pnpm-store/
.DS_Store

# Local working files, not part of the repo. /local/ is the standing boundary:
# anything that is not shipped JS goes in there and nothing inside can leak.
# See ../../README.md. The named directories below predate it.
/local/
dev/
outputs/
test-output/
tmp/
*.local/

# Playwright
test-results/
playwright-report/
playwright/.cache/

# Live payloads captured by the e2e smoke run, for the private twins to
# resolve. Regenerated by `npm run test:e2e`; never a source of truth.
e2e/.captures/
